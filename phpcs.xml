<?xml version="1.0"?>
<ruleset name="ajrwebdesign-core">
	<description>WordPress Coding Standards for ajrwebdesign-core.</description>

	<file>ajrwebdesign-core.php</file>
	<file>src</file>
	<file>blocks</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- PSR-4 file naming (Plugin.php, not class-plugin.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is fine; both sniffs conflict across standards. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ajrwebdesign-core"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>
