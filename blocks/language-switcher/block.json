{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajrwebdesign-core/language-switcher",
	"version": "1.0.0",
	"title": "Language Switcher",
	"category": "theme",
	"icon": "translation",
	"description": "Polylang language switcher as a labeled dropdown: current language with flag and name, other languages in a card. Renders nothing with fewer than two languages.",
	"keywords": [ "language", "polylang", "switcher", "translation" ],
	"textdomain": "ajrwebdesign-core",
	"attributes": {
		"showFlags": { "type": "boolean", "default": true },
		"showNames": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"typography": { "fontSize": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
