{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajrwebdesign-core/case-study-card",
	"title": "Case Study Card",
	"category": "widgets",
	"icon": "analytics",
	"description": "Full case-study showcase. An audit shows mobile/desktop score circles, Core Web Vitals metrics and impact tiles; a site build shows its screenshots and Google PageSpeed scores.",
	"keywords": [ "case study", "results", "performance", "core web vitals", "site build", "screenshots" ],
	"textdomain": "ajrwebdesign-core",
	"attributes": {
		"caseStudyId": { "type": "number", "default": 0 },
		"layoutDirection": { "type": "string", "default": "stats-left", "enum": [ "stats-left", "text-left" ] },
		"variant": { "type": "string", "default": "default", "enum": [ "default", "hero" ] },
		"ctaUrl": { "type": "string", "default": "" },
		"ctaLabel": { "type": "string", "default": "" },
		"ctaSecondaryUrl": { "type": "string", "default": "" },
		"ctaSecondaryLabel": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"spacing": { "margin": true }
	},
	"usesContext": [ "postId", "postType" ],
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
